# Copy to `.env` and fill in. `.env` is gitignored.

# `production` is a claim about the deployment: public, over TLS, behind a
# proxy, with a real secret. It is checked at startup, and a half-finished
# deployment stops the process rather than serving strangers — it requires
# SESSION_COOKIE_SECURE=true and a SECRET_KEY. Leave it as `development` until
# the host and TLS are in place.
ENVIRONMENT=development

# NewsAPI.org — https://newsapi.org/account
# Free tier: 100 requests/day, articles delayed by 24h, search window is 1 month.
NEWSAPI_KEY=

# NewsData.io — https://newsdata.io/dashboard
# Free tier: 200 credits/day, ~12h delay, richer metadata (image, sentiment, country).
NEWSDATA_KEY=

# FreeNewsApi.io — https://www.freenewsapi.io/
# Free tier: 5,000 requests/day, 2 requests/second. Listings return ten items
# with no image or link, so each article costs one extra `/v1/details` call.
# It is the only provider with enough headroom to paginate indefinitely.
FREENEWSAPI_KEY=

# Server
HOST=127.0.0.1
PORT=8000

# SQLite database file, relative to the backend directory.
DATABASE_PATH=data/news.db

# How long a cached provider response stays fresh (seconds).
CACHE_TTL_SECONDS=1800

# Hard daily request ceilings. The aggregator refuses to call a provider once
# its ceiling is reached and serves stale cache instead.
NEWSAPI_DAILY_LIMIT=100
NEWSDATA_DAILY_LIMIT=200
FREENEWSAPI_DAILY_LIMIT=5000

# FreeNewsApi pacing. A listing is always ten items; `DETAIL_BUDGET` caps how
# many per-article detail calls one feed request may spend on top of that.
FREENEWSAPI_PAGE_SIZE=10
FREENEWSAPI_DETAIL_BUDGET=10
FREENEWSAPI_REQUESTS_PER_SECOND=2.0

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# Reader mode
#
# Two of the three providers never return an article body — NewsAPI truncates
# at ~200 characters and NewsData answers "ONLY AVAILABLE IN PAID PLANS". So
# when a story is opened, the publisher's own page is read once and its text
# kept forever. That costs no provider quota and is what gives a summary
# something to condense. Set READER_ENABLED=false to turn it off entirely.
READER_ENABLED=true
READER_TIMEOUT_SECONDS=8
READER_MAX_BYTES=500000
READER_MAX_CHARS=20000
READER_MIN_CHARS=240
# Publisher reads allowed in flight at once, per process.
READER_CONCURRENCY=4
# A page that yielded no text is not tried again until this has passed, so a
# paywall is fetched once a week rather than on every view.
READER_RETRY_SECONDS=604800

# Request guards
#
# Per-client ceilings. The free news tiers are the scarce resource, so abusive
# traffic is stopped before it can spend any of them; sign-in gets its own,
# much lower, ceiling because it is the one endpoint worth brute-forcing.
RATE_LIMIT_REQUESTS=240
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REQUESTS=30
RATE_LIMIT_AUTH_WINDOW_SECONDS=300
# Largest request body accepted. Every body here is a few hundred bytes of JSON.
MAX_REQUEST_BYTES=65536
# Take the client address from `x-forwarded-for`. Only correct while this
# service is reached through the Astro proxy rather than exposed directly; set
# false if you put it on the public internet by itself.
TRUST_FORWARDED_FOR=true
# The same arrangement, spelled out. When the frontend and this API are on
# different hosts — Vercel in front, a public URL for the API — the API is
# reachable by anyone who has the hostname, and `x-forwarded-for` stops being
# evidence of anything: a stranger can send a new address with every request
# and be counted as a new client each time, which spends the day's provider
# allowance in a minute. The Astro proxy sends this value on every forwarded
# request and refuses nothing else. Leave empty when the API is on a private
# network that only the proxy can reach.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_SECRET=

# Searches
#
# A search is the one request that cannot be answered from the cache: every
# distinct query is its own cache key, and therefore its own upstream call. The
# daily provider ceilings are only 300 calls in total, so an open `/api/search`
# lets one client spend the whole day's allowance for everyone in under a
# minute — after which the feed serves yesterday's news until midnight UTC.
# Each client therefore gets this many *new* searches a day; a query already
# cached is free and never counted. Set the anonymous allowance to 0 to require
# an account to search at all.
SEARCH_DAILY_QUERIES_ANONYMOUS=5
SEARCH_DAILY_QUERIES_USER=50

# Feed quality
#
# Extra hosts to keep out of the feed, comma-separated. Each entry matches its
# own host and any subdomain of it, so `badsyndicator.com` also drops
# `news.badsyndicator.com`. Rows whose link is an aggregator rather than a
# publisher, and rows whose thumbnail is a stock placeholder, are dropped
# regardless — those rules live in `app/services/quality.py`.
FEED_BLOCKED_DOMAINS=

# Accounts
#
# Encrypts readers' AI provider keys at rest. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Until it is set, saving a provider key is refused — deliberately, because the
# alternative is storing keys in the clear. Changing it makes existing keys
# unreadable; readers simply add theirs again.
SECRET_KEY=
# How long a sign-in lasts, as a maximum rather than a browser-only expiry.
SESSION_TTL_DAYS=30
# Set true once the site is served over HTTPS. This does two things: the
# session cookie is marked Secure so it is never sent in plaintext, and the API
# starts advertising HSTS. Leaving it false on a TLS deployment is the one way
# a session can still be read in transit.
SESSION_COOKIE_SECURE=false

# AI summaries (readers bring their own free-tier key on the account page).
# Named here because models get retired; the defaults are the current free ones.
# Keep the OpenRouter one non-reasoning (`reasoning.default_enabled: false`):
# a model that thinks first spends the whole token budget and returns no answer.
AI_GROQ_MODEL=llama-3.3-70b-versatile
AI_OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Tried in order when the model above has no free capacity — a `:free` model
# draws on a pool shared with every other anonymous caller. Two at most.
AI_OPENROUTER_FALLBACKS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-lightning:free
AI_GEMINI_MODEL=gemini-2.0-flash
# Writing a summary takes tens of seconds, far longer than a feed request.
AI_REQUEST_TIMEOUT_SECONDS=75
# How much article text is sent upstream, and how long a summary is kept.
AI_MAX_INPUT_CHARS=6000
AI_SUMMARY_TTL_SECONDS=7776000
